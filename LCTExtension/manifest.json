{
  "manifest_version": 3,
  "name": "LoL Custom Tool Connector",
  "version": "1.0",
  "permissions": ["scripting"],
  "host_permissions": [
    "https://yamadalter.github.io/LOLCustomTool",
    "https://127.0.0.1/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "https://yamadalter.github.io/LOLCustomTool/*"
      ],
      "js": ["content_script.js"]
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}

