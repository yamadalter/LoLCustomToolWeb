{
  "manifest_version": 3,
  "name": "LoL Custom Tool Connector",
  "version": "1.0",
  "permissions": ["scripting"],
  "host_permissions": [
    "http://localhost:3000/*", 
    "https://yamadalter.github.io/LOLCustomTool/*",
    "https://lo-l-custom-tool-web.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*", 
        "https://yamadalter.github.io/LOLCustomTool/*",
        "https://lo-l-custom-tool-web.vercel.app/*"
      ],
      "js": ["content_script.js"]
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}