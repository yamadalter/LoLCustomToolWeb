{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/api/update_ratings",
      "dest": "api/update_ratings.py"
    },
    {
      "src": "/api/get_all_ratings",
      "dest": "api/get_all_ratings.py"
    },
    {
      "src": "/api/get_ratings",
      "dest": "api/generate_teams.py"
    },
    {
      "src": "/api/upload",
      "dest": "api/upload.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
